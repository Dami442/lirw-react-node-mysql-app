user nginx;
worker_processes auto;
pid /run/nginx.pid;

# Redirect error logs to standard error for AWS CloudWatch tracking
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Production-optimized log format matching CloudWatch structured patterns
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    # Redirect access logs directly to standard output for CloudWatch collection
    access_log /dev/stdout main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;

    server {
        listen 80;
        server_name ${SERVER_NAME};

        root /usr/share/nginx/html;
        index index.html index.htm;

        # Critical Target Group Health Check endpoint for Frontend ALB
        location /health {
            default_type text/html;
            return 200 "<!DOCTYPE html><p>Health check endpoint</p>\n";
        }

        # React Router SPA Single Page Application Routing
        location / {
            try_files $uri $uri/ /index.html;
        }

        # Dynamic Reverse Proxy to the Internal Backend ALB
        location /api/ {
            # Handled via environment variable interpolation at runtime
            proxy_pass ${BACKEND_ALB_URL};

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # Prevent buffering issues with streaming API responses
            proxy_buffering off;
        }
    }
}